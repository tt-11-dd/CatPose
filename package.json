{
  "name": "catpose",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Collect cute cat poses — web first, Android later.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply catpose-db --local",
    "db:remote": "wrangler d1 migrations apply catpose-db --remote",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "lucide-react": "^0.552.0",
    "onnxruntime-web": "^1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0"
  }
}
